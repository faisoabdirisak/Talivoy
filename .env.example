# Server environment
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL="file:./dev.db"
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Set AI_PROVIDER=granite to use IBM watsonx.ai.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-4-h-small

# Optional Docling extraction with local text extraction as a fallback.
DOCLING_ENABLED=false
DOCLING_SERVICE_URL=
DOCLING_SERVICE_API_KEY=

# Netlify only: set this in the hosting dashboard, never in browser variables.
# Use at least 32 random characters and retain the value across deployments.
ACTION_SIGNING_SECRET=
# Netlify provisions NETLIFY_DB_URL automatically. Do not upload local .env or SQLite files.
