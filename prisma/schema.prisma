// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                    String        @id @default(cuid())
  /// Opaque random token stored in an HttpOnly cookie — used for guest isolation.
  /// Never returned in API responses.
  cookieToken           String        @unique @default(cuid())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  /// The opportunity the user has selected to focus on (null = none selected)
  selectedOpportunityId String?
  opportunities         Opportunity[]
  adviserShares         AdviserShare[]
}

model Opportunity {
  id               String      @id @default(cuid())
  sessionId        String
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title            String
  category         String      // 'career-pivot' | 'upskilling' | 'micro-business'
  summary          String
  reasoning        String
  /// Computed server-side in TypeScript — never from AI output
  feasibilityScore Int
  rank             Int
  /// Versioned validated explanation JSON; null for older saved results.
  explanationJson  String?
  planItems        PlanItem[]
  adviserFeedback  AdviserFeedback[]
  weeklyCheckIns   WeeklyCheckIn[]
  pathwayItems     CareerPathwayItem[]
  skillsEvidence   SkillEvidence[]
}

model PlanItem {
  id             String         @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  day            Int
  week           Int
  title          String
  description    String?
  resourceUrl    String?
  progressEntry  ProgressEntry?
  reminder       MilestoneReminder?
  pathwayItem    CareerPathwayItem?
}

model ProgressEntry {
  id          String    @id @default(cuid())
  planItemId  String    @unique
  planItem    PlanItem  @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model Evaluation {
  source           String   @default("live")
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  opportunityTitle String
  name             String
  role             String
  affiliation      String
  reviewerCode     String
  fit              String
  reason           String
  firstStep        String
  usefulness       String
  reportChanges    String
  friction         String

  @@index([createdAt])
}

model MilestoneReminder {
  id         String   @id @default(cuid())
  planItemId String   @unique
  planItem   PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  dueAt      DateTime
}

model AdviserShare {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  opportunityId String?
  responses AdviserFeedback[]
  snapshotJson String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}


model AdviserFeedback {
  id                  String @id
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  shareId             String?
  share               AdviserShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  reviewerName        String
  reviewerRole        String
  practicality        String
  assessment          String
  milestoneSuggestion String
  nextStep            String
  nextStepDetails     String
  createdAt           DateTime @default(now())
  acceptedAt          DateTime?
}

model WeeklyCheckIn {
  id               String @id
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  completedWork    String
  blockers         String
  budget           Int
  hours            Float
  createdAt        DateTime @default(now())
  appliedAt        DateTime?
  appliedRevision  String?
}


model CareerPathwayItem {
  id             String @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  state          String
  career         String
  stepKey        String
  status         String @default("To check")
  notes          String @default("")
  reviewedAt     DateTime?
  updatedAt      DateTime @updatedAt
  planItemId     String? @unique
  planItem       PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@unique([opportunityId, state, career, stepKey])
}

model SkillEvidence {
  id                String @id @default(cuid())
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill             String
  source            String
  evidence          String
  status            String
  nextStep          String
  bullet            String?
  bulletReviewedAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([opportunityId])
}
